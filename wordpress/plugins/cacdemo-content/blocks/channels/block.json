{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cacdemo/channels",
	"title": "Social channels",
	"category": "widgets",
	"icon": "share",
	"description": "The church's social media pages and groups, from the Social channels list. Compact (icon and short name), list (with what's posted there) or feeds (cards with Facebook's page widget).",
	"textdomain": "cacdemo",
	"attributes": {
		"variant": { "type": "string", "enum": [ "compact", "list", "feeds" ], "default": "compact" },
		"platform": { "type": "string", "default": "" },
		"homeOnly": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "wide" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "cacdemo-channels",
	"render": "file:./render.php"
}
