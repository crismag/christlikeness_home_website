{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "dark", "color": "#0d141a", "name": "Dark" },
				{ "slug": "light", "color": "#ffffff", "name": "Light" },
				{ "slug": "accent", "color": "#2c5f6f", "name": "Accent" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--light)",
			"text": "var(--wp--preset--color--dark)"
		}
	},
	"templateParts": [
		{ "name": "header", "area": "header" },
		{ "name": "footer", "area": "footer" }
	]
}
